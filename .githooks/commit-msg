#!/bin/sh
# <type>: <imperative summary>, the summary under 72 characters (CONVENTIONS.md, Git).
first=$(head -n 1 "$1")
if ! printf '%s' "$first" | grep -Eq '^(feat|fix|refactor|test|docs|chore|perf)(\([a-z0-9-]+\))?: .{1,64}$'; then
  echo "commit-msg: use '<type>: <summary>' (feat, fix, refactor, test, docs, chore, perf), 72 characters at most" >&2
  exit 1
fi
